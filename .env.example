TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
POSTGRES_USER=agy
POSTGRES_PASSWORD=agy_password
POSTGRES_DB=telegram_agy
DATABASE_URL=postgresql+asyncpg://agy:agy_password@db:5432/telegram_agy
ALEMBIC_DATABASE_URL=postgresql+psycopg2://agy:agy_password@db:5432/telegram_agy
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
REDIS_URL=redis://redis:6379/2
# Effort is baked into the name (-low/-medium/-high). `agy models` lists
# options: Claude Sonnet/Opus 5.5, Gemini 3.x Flash, Gemini 3.1 Pro. Avoid
# -low if you enable Composio — it drops multi-step tool tasks.
AGY_MODEL=gemini-3.8-flash-high
AGY_TIMEOUT_SECONDS=300
# Model routing. Before each run, Jev (TypeSafe's decision model, via
# OpenRouter's Decisions API) reads the pending message(s) + a few recent lines
# and picks AGY_MODEL (plain chat, quick Q&A) or AGY_MODEL_COMPLEX (market
# outlook, evaluation, multi-step reasoning). ~0.7s, ~$0.00002 per reply.
# Anything going wrong with it (timeout, bad answer, HTTP error) falls back to
# AGY_MODEL. Leave OPENROUTER_API_KEY empty to turn routing off.
# NOTE: those messages go to OpenRouter and TypeSafe — see docs/security.md.
OPENROUTER_API_KEY=
ROUTER_MODEL=~typesafe/jev-latest
ROUTER_TIMEOUT_SECONDS=5
AGY_MODEL_COMPLEX=gemini-3.1-pro-high
# Pro is slower and complex asks are tool-heavy, so they get a longer budget.
AGY_TIMEOUT_SECONDS_COMPLEX=480
AGY_MCP_URL=http://mcp:8000/mcp
MCP_PORT=8000
# How many recent messages go into each prompt. NOT retention — see below.
CONTEXT_MESSAGE_LIMIT=30
# Messages older than this are pruned hourly, except each thread's newest
# CONTEXT_MESSAGE_LIMIT rows (a quiet thread never loses its context). Older
# messages stay searchable via the `search_history` tool until they are pruned.
MESSAGE_RETENTION_DAYS=10
HISTORY_SEARCH_LIMIT=20
# Max images handed to agy per reply, picked in priority order: the photo on the
# trigger, then the photo it replies to, then the newest ones in the window.
# Each image costs real input tokens and latency — raise with care.
# 0 disables image understanding entirely. Only photos and image/* documents are
# fetched; audio is NOT transcribable by agy (verified) so voice notes are not.
MEDIA_MAX_PER_RUN=5
MEDIA_MAX_DOWNLOAD_MB=20
# A photo with no explicit link to the question (not on the trigger, not the
# message it replies to) is only attached if it was posted within this many
# seconds of the trigger — catches albums and "photo, then asks", and stops every
# unrelated message from re-downloading old photos.
MEDIA_CONTEXT_SECONDS=60
# Emoji reacted onto a message while the bot is working on it, cleared once the
# reply lands (and left in place if the run fails, as the only "I saw it" trace).
# Empty disables. Must be an emoji Telegram allows bots to react with.
REACTION_ACK=👀
LOG_LEVEL=INFO
LOG_FORMAT=plain
# Docker log driver (read by docker-compose.yml). Use journald on the VPS so
# logs survive a deploy; json-file (default) is wiped whenever a container is
# recreated. Docker Desktop has no journald.
#LOG_DRIVER=journald

# Optional — give agy the Composio CLI (web search, Gmail, Drive, Slack, ...).
# It shells out to `composio search|execute` only when a message needs it, so
# there is no per-reply token cost. Leave empty to skip.
# The value must be a `uak_...` USER API key (not ak_ / oak_ / ck_): run
# `composio login` once on any machine and copy the "api_key" field from
# ~/.composio/user_data.json. Whatever apps you've connected in that Composio
# account become available.
# NOTE: agy runs --dangerously-skip-permissions, so it executes these tools with
# no approval — anyone who can message the bot can act on your connected Composio
# accounts. Only enable on a private / trusted deployment.
COMPOSIO_API_KEY=
